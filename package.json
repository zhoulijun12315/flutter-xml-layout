{
  "name": "flutter-xml-layout",
  "displayName": "XML Layout for Flutter (Ark7)",
  "description": "XML Layout for Flutter (Ark7). Brings Angular's style to Flutter! Actively maintained fork with a headless CLI/MCP generator.",
  "publisher": "zhoulijun12315",
  "version": "0.1.0",
  "icon": "images/logo.png",
  "repository": {
    "type": "github",
    "url": "https://github.com/zhoulijun12315/flutter-xml-layout"
  },
  "engines": {
    "vscode": "^1.34.0"
  },
  "keywords": [
    "flutter",
    "dart",
    "widgets",
    "xml",
    "angular"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onCommand:flutter.xml-layout.regenerate-all"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "fxml": "./bin/xml-layout.js",
    "xml-layout": "./bin/xml-layout.js",
    "xml-layout-mcp": "./bin/xml-layout-mcp.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "flutter.xml-layout.regenerate-all",
        "title": "XML Layout for Flutter: Re-generate all XML & JSON files"
      }
    ],
    "snippets": [
      {
        "language": "dart",
        "path": "./snippets/dart.json"
      },
      {
        "language": "xml",
        "path": "./snippets/xml.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode production",
    "compile-prod": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode production",
    "compile": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode none",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode none",
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test-compile": "tsc -p ./",
    "cli:build": "tsc -p tools/tsconfig.build.json",
    "cli": "node .tools-out/tools/generate.js",
    "mcp": "node .tools-out/src/mcp/server.js"
  },
  "devDependencies": {
    "@types/mkdirp": "^0.5.2",
    "@types/mocha": "^2.2.42",
    "@types/node": "^10.12.21",
    "@types/q": "^1.5.2",
    "@types/rgrove__parse-xml": "^1.1.0",
    "mkdirp": "^0.5.1",
    "ts-loader": "^6.0.4",
    "ts-node": "^8.2.0",
    "tslint": "^5.12.1",
    "typescript": "^3.3.1",
    "vscode": "^1.1.37",
    "webpack": "^4.35.3",
    "webpack-cli": "^3.3.5"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^2.0.1",
    "q": "^1.5.1"
  }
}
